 title = {ublkcache: Linux ublkストレージに対するカーネル内ページキャッシュ利活用機構},
 volume = {2025},
 year = {2025},
 abbr = {Domestic},
 website= {https://ipsj.ixsq.nii.ac.jp/records/2005951},
