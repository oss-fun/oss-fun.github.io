@inproceedings{10.1145/3774898.3778040,
  author = {Nakata, Yuki and Matsubara, Katsuya},
  title = {Self-Hosted WebAssembly Runtime for Runtime-Neutral Checkpoint/Restore in Edge-Cloud Continuum},
  year = {2025},
  month = {Dec},
  isbn = {9798400723018},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  url = {https://doi.org/10.1145/3774898.3778040},
  doi = {10.1145/3774898.3778040},
  abstract = {Checkpoint/restore (C/R) in the Edge-Cloud Continuum, where edge servers and cloud servers are integrated to combine their respective computational characteristics, enables application live migration for load balancing and service continuity that adapts to user mobility. WebAssembly (Wasm) provides architecture neutrality, allowing bytecode execution across diverse platforms. Furthermore, by leveraging runtime implementations specialized for particular environments and performance optimizations such as Just-In-Time (JIT) and Ahead-Of-Time (AOT) compilation, Wasm bytecode can be executed efficiently by using the runtime best suited to each environment. However, the diversity of runtimes and performance optimizations results in heterogeneous representations of application execution states, making it difficult to apply C/R across multiple runtimes. To address this heterogeneity, we propose a C/R method that employs a self-hosted Wasm runtime compiled into Wasm itself. By checkpointing and restoring application execution states within the self-hosted Wasm runtime, the representation of execution states can be unified. In addition, to mitigate the overhead of duplicated runtime executions, we also investigate optimization techniques for Wasm runtimes designed to be self-hosted. Our evaluation results demonstrate that C/R with a self-hosted Wasm runtime can eliminate runtime differences and enable efficient live migration with a minimal execution state.},
  booktitle = {Proceedings of the 3rd International Workshop on Middleware for the Computing Continuum},
  pages = {19–24},
  numpages = {6},
  keywords = {Checkpoint/Restore, Live Migration, Self-Hosted WebAssembly Runtime},
  location = {Vanderbilt University, Nashville, TN, USA},
  series = {Mid4CC '25},
  abbr = {International Conf.},
  selected= true,
}

@INPROCEEDINGS{cander-yuzuki,
  author={Matsubara, Katsuya and Saito, Yuzuki and Fujii, Daigo and Nakata, Yuki},
  booktitle={2025 Thirteenth International Symposium on Computing and Networking Workshops (CANDARW)}, 
  title={Seamless Self-Healing in WebAssembly Container Orchestration with Runtime-Neutral Checkpointing}, 
  year={2025},
  volume={},
  number={},
  pages={29-35},
  keywords={Checkpointing;Cloud computing;Runtime;Switches;Containers;Webassembly;Prediction algorithms;Monitoring;Resilience;Edge computing;Dependable System;Fault Tolerance;Cloud Computing;Edge Computing;Live Migration;Kubernetes},
  doi={10.1109/CANDARW68385.2025.00013},
  abbr = {International Conf.},
  selected= true,
  abstract= {Modern cloud-native systems increasingly rely on WebAssembly (Wasm) containers for their lightweight nature and fast startup times. However, ensuring high availability in the face of inevitable failures remains a critical challenge. Traditional selfhealing mechanisms, often based on simple container restarts, cause service disruption and performance degradation. This paper presents a novel approach to achieve seamless self-healing in Wasm container orchestration by leveraging a runtime-neutral checkpointing framework. This framework, developed in our prior work, captures an application’s complete execution state independent of any specific runtime implementation. Building on this foundation, we demonstrate how this capability enables two key functions: hot restart and dynamic runtime switching. Hot restart allows a failed container to be restored from a checkpoint in milliseconds, eliminating the overhead of a cold startup. More importantly, we introduce a new paradigm for memory pressure alleviation without Pod eviction. By utilizing our runtime-neutral checkpoints, the orchestration system can gracefully switch a running application from a high-performance runtime (e.g., WasmEdge) to a more memory-efficient one (e.g., WAMR) when resources are constrained. Our empirical evaluation confirms that this approach effectively alleviates memory pressure while causing only a minimal, short-lived performance impact, proving to be a superior alternative to disruptive evictionbased methods.}
}


@inproceedings{oai:ipsj.ixsq.nii.ac.jp:02005946,
 author	 = "優月 齊藤 and 大悟 藤井 and 克弥 松原 and 裕貴 中田",
 booktitle = {コンピュータシステム・シンポジウム論文集},
 month = {Nov},
 abstract = {WebAssembly(Wasm)コンテナは，OS，CPUアーキテクチャに依存しない軽量な隔離実行環境であり，エッジコンピューティングにおけるアプリケーション実行基盤として注目されている．Wasmを実行するランタイムには，計算性能やメモリ使用量など，特性の異なる実装が存在するため，各計算機の状況に応じてこれらを使い分けることで，エッジコンピューティングの計算機環境を活用できる．Wasmサンドボックス内部の状態を異なるランタイム間で保存，復元することが可能な先行研究と，コンテナオーケストレータのヒーリング機能を統合することで，メモリ使用量等，状況に適したランタイムへの動的な切り替えが可能である．現在，多くのクラウドアプリケーションはへのアクセスが必須であり，Wasmは，Wasm System Interface(WASI)を介すことで，ホストのネットワークにアクセスする．しかし，WASIを介したネットワークへのアクセス状態は，Wasmサンドボックス外部の状態であるため，先行研究の手法では，ネットワークにアクセスするWasmアプリケーションの状態を復元できない．本研究では，ネットワークへのアクセス状態を含むWasmアプリケーションのマイグレーションを実現する手法を提案する．Wasm仮想マシン内部の状態に加え，WASIを介してアクセスしたソケットの状態を保存・復元することで，ネットワークへのアクセス状態を含むマイグレーションを可能にする．これによって，ネットワークにアクセスするクラウドアプリケーションの，柔軟なオーケストレーションを実現する．},
